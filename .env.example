MONGODB_URI=mongodb://127.0.0.1:27017/sarvadnya-infotech
MONGODB_DB=sarvadnya-infotech
MEGA_EMAIL=your-mega-email
MEGA_PASSWORD=your-mega-password
# AI providers for Sara. Prefer setting these via the admin Settings page (stored in MongoDB).
# GEMINI_API_KEY is the primary provider; GROQ_API_KEY is the fallback.
GEMINI_API_KEY=
GROQ_API_KEY=

# Vercel Blob (required for all image + resume uploads). CRITICAL: these must ALSO be
# added to the Vercel project environment (Dashboard > Settings > Environment Variables)
# for Production — the local .env is gitignored and never reaches the deployed site.
# Create a store with `npx vercel blob add` (auto-injects the vars) or paste here.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx
BLOB_STORE_ID=store_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SUPPORT_PHONE=9821309060
NEXT_PUBLIC_SUPPORT_EMAIL=info@sarvadnyainfotech.com
NEXT_PUBLIC_OFFICE_ADDRESS="123, Business Center, Main Road, Pune - 411001"
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/sarvadnyainfotech
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/sarvadnya.infotech/
NEXT_PUBLIC_INSTAGRAM_HANDLE=@sarvadnya.infotech
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/sarvadnyainfotech
NEXT_PUBLIC_YOUTUBE_URL=https://www.youtube.com/@sarvadnyainfotechtally
NEXT_PUBLIC_YOUTUBE_HANDLE=@sarvadnyainfotechtally

# Admin access key: Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Proxy checks x-admin-key header or admin_key cookie against this value
ADMIN_ACCESS_KEY=

# ── Resend Email (internal form-copy notifications) ─────────────
# Create an API key at https://resend.com/api-keys
# CRITICAL: sarvadnyainfotech.com must be verified in the Resend dashboard
# (SPF + DKIM + DMARC DNS records) before emails will deliver.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Sender address — must be on a domain verified in Resend.
RESEND_SENDER_EMAIL=webenquiry@en.sarvadnyainfotech.com
# Internal-only recipient allowlist (comma-separated). The server resolves the
# recipient from these; clients can NEVER choose who receives internal emails.
# Per-page recipients are managed in the admin panel (/admin/email-config):
#   - EMAIL_DESTINATION_RECIPIENTS  (JSON per-page map, opt-in — pages with no
#     configured recipient send NO email; only `demo` is pre-wired)
#   - EMAIL_FORM_RECIPIENTS         (JSON per-form-type fallback)
# This env var is the final fallback for any unset destination/form type.
RESEND_INTERNAL_TO=info@sarvadnyainfotech.com
# Optional: per-IP rate limit for /api/email/submit (requests per minute).
EMAIL_RATE_LIMIT=30
# Email is sent DIRECTLY (inline) on form submission via Resend — see
# lib/email-queue.ts (sendEmailDirect). No queue drain or cron is needed for
# delivery, so Vercel's 2-cron/day limit cannot affect emails. Failed sends are
# recorded in the MongoDB ledger and retried from the admin panel.
# Optional: max send attempts per email before it is marked dead.
EMAIL_MAX_ATTEMPTS=5
# Optional cron secret for an EXTERNAL scheduler (GitHub Actions / Upstash
# QStash) that calls /api/admin/email/process?batch=N to retry failed sends.
# Vercel's own cron is no longer used for email. Set in the Vercel project env.
CRON_SECRET=

# ── Client auto-reply (thank you for contacting) ───────────────────────
# A branded thank-you email is sent to the SUBMITTER'S OWN address on every
# form submission, in addition to the internal company copy. Exactly one email
# reaches each recipient (dedupe is the same unique jobKey claim). The internal
# company copy is unchanged.
# KILL-SWITCH: AUTO_REPLY_ENABLED defaults to OFF (0). Nothing is emailed to
# clients until this is set to 1 in the Vercel project env — safe to deploy.
# AUTO_REPLY_ENABLED=0
# replyTo on the client email (what the customer sees when they hit reply).
AUTO_REPLY_REPLY_TO=info@sarvadnyainfotech.com
# Optional: override the From for the auto-reply. Defaults to RESEND_SENDER_EMAIL
# (keep it on a domain verified in Resend).
# AUTO_REPLY_FROM=

# ── Global CC (one address, ALL emails) ────────────────────────────────
# CHANGE: 2026-10-07 — a single CC address is added to every email the site
# sends: the internal form copies AND the customer auto-reply. Configured in
# the admin panel (/admin/email-config, shared DB — one place configures both
# deployments) or via these env vars. OFF by default; even when ON, an empty or
# invalid address produces NO cc — enabling can never break or trigger a send.
# EMAIL_CC_ENABLED=0
# EMAIL_CC=

# ── Passive Visitor Identification ────────────────────────
# Client-side VisitorProvider beacons page views to /api/identify; the server
# upserts one `visitors` doc per session cookie (svd_vid) and enriches IPs via
# ipwho.is (cache-first into `ip_cache`). Form submissions capture IP/UA/geo
# into form_submissions and the internal email copy.
# Set VISITOR_ENABLED=0 to disable collection entirely (kill switch).
VISITOR_ENABLED=1
# Addresses that must NEVER be recorded — comma-separated, exact match. Used to keep
# development traffic out of the production database: the dev server shares the same
# MONGODB_URI as production, so without this every local page load creates a real
# `visitors` document (and form tests create real submissions and send real email).
# Loopback (127.*, ::1, 0.0.0.0, ::ffff:127.*) is ALWAYS ignored automatically and does
# not need to be listed. Add any other address you browse or test from — the LAN IPs
# and the machine's public IP (see `allowedDevOrigins` in next.config.js). Note a
# public address here is important: it is not covered by the private-range check, so
# without it the dev box triggers a real ipwho.is and reverse-DNS lookup and looks
# like a genuine visitor.
VISITOR_IGNORE_IPS=
# Geo provider. Any provider returning { success:false } on failure works; the
# default ipwho.is needs no key and returns rich ISP/ASN fields over HTTPS.
IP_LOOKUP_API=https://ipwho.is
# Runtime log verbosity for the [visitor] logger: debug | info | warn | off.
VISITOR_LOG_LEVEL=info

# ─────────────────────────────────────────────────────────────────────────────
# Razorpay — /demo cart scaffold (SP-1). TEST MODE ONLY.
#
# Paste values into your LOCAL .env, never into this file — it is tracked by git.
# BOTH server keys must begin with `rzp_test_`. lib/demo/razorpay.ts throws on
# anything else, so test mode is enforced by code, not by convention.
# Generate test keys: Razorpay Dashboard → Settings → API Keys → Generate Test Key.
#
# NEXT_PUBLIC_RAZORPAY_KEY_ID is deliberately NOT used. The publishable key id reaches the
# browser through the /api/demo/order response (getPublishableKeyId() -> `keyId`), NOT by being
# inlined into the client bundle at build time. Nothing Razorpay-related is baked into JS.
# (The key id is public in the sense that Razorpay requires shipping it to the browser, but
# keeping it out of the bundle means a rebuild is not needed to change keys and there is one
# less place for it to leak from.)
# RAZORPAY_KEY_SECRET is never sent anywhere — no route returns it and nothing logs it. It must
# never carry a NEXT_PUBLIC_ prefix.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional. Test orders per IP per minute for POST /api/demo/order. Default 20 when unset.
DEMO_ORDER_RATE_LIMIT=
