MONGODB_URI=mongodb://127.0.0.1:27017/sarvadnya-infotech
MONGODB_DB=sarvadnya-infotech
MEGA_EMAIL=your-mega-email
MEGA_PASSWORD=your-mega-password
# AI providers for Sara. Prefer setting these via the admin Settings page (stored in MongoDB).
# GEMINI_API_KEY is the primary provider; GROQ_API_KEY is the fallback.
GEMINI_API_KEY=
GROQ_API_KEY=

# Vercel Blob (required for all image + resume uploads). CRITICAL: these must ALSO be
# added to the Vercel project environment (Dashboard > Settings > Environment Variables)
# for Production — the local .env is gitignored and never reaches the deployed site.
# Create a store with `npx vercel blob add` (auto-injects the vars) or paste here.
BLOB_READ_WRITE_TOKEN=vercel_blob_rw_xxxxxxxxxxxxxxxxxxxx
BLOB_STORE_ID=store_xxxxxxxxxxxxxxxxxxxx
NEXT_PUBLIC_SUPPORT_PHONE=9821309060
NEXT_PUBLIC_SUPPORT_EMAIL=info@sarvadnyainfotech.com
NEXT_PUBLIC_OFFICE_ADDRESS="123, Business Center, Main Road, Pune - 411001"
NEXT_PUBLIC_FACEBOOK_URL=https://facebook.com/sarvadnyainfotech
NEXT_PUBLIC_INSTAGRAM_URL=https://instagram.com/sarvadnyainfotech
NEXT_PUBLIC_LINKEDIN_URL=https://linkedin.com/company/sarvadnyainfotech

# Admin access key: Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Proxy checks x-admin-key header or admin_key cookie against this value
ADMIN_ACCESS_KEY=

# ── Resend Email (internal form-copy notifications) ─────────────
# Create an API key at https://resend.com/api-keys
# CRITICAL: sarvadnyainfotech.com must be verified in the Resend dashboard
# (SPF + DKIM + DMARC DNS records) before emails will deliver.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Sender address — must be on a domain verified in Resend.
RESEND_SENDER_EMAIL=webenquiry@en.sarvadnyainfotech.com
# Internal-only recipient allowlist (comma-separated). The server resolves the
# recipient from these; clients can NEVER choose who receives internal emails.
# Per-page recipients are managed in the admin panel (/admin/email-config):
#   - EMAIL_DESTINATION_RECIPIENTS  (JSON per-page map, opt-in — pages with no
#     configured recipient send NO email; only `demo` is pre-wired)
#   - EMAIL_FORM_RECIPIENTS         (JSON per-form-type fallback)
# This env var is the final fallback for any unset destination/form type.
RESEND_INTERNAL_TO=ankitmali50@gmail.com
# Optional: per-IP rate limit for /api/email/submit (requests per minute).
EMAIL_RATE_LIMIT=30
# Email is sent from a MongoDB-backed queue (lib/email-queue.ts). The public
# submit route only enqueues; drains run via next/server `after()` + a 1-min
# Vercel Cron (/api/admin/email/process). Set to 1 to skip the background drain
# (used by automated tests for deterministic queue-state assertions).
EMAIL_DISABLE_BACKGROUND=0
# Optional: max send attempts per queued email before it is marked dead.
EMAIL_MAX_ATTEMPTS=5
